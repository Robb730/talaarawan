# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings -> API -> Project URL / anon public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Brevo credentials are NOT browser variables. Set them as Supabase secrets:
#   supabase secrets set BREVO_API_KEY=your-brevo-api-key
#   supabase secrets set BREVO_SENDER_EMAIL=no-reply@yourdomain.com
#   supabase secrets set BREVO_SENDER_NAME="TalaArawan"
# See supabase/EMAIL_SETUP.md for the full setup.
